# Ferrowave Weekly Insights Digest - Environment Variables
# Copy this file to .env and fill in your values

# Optional: Gemini API key for LLM-based theme extraction
# If not set, the tool uses code-based keyword clustering (zero cost)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model selection (default: gemini-2.5-flash)
MODEL_NAME=gemini-2.5-flash
